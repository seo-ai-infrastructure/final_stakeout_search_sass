// packages/db/prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          String         @default("AGENCY")
  creditBalance Int            @default(0)
  /// Briefs bought (packs, the Closer Pack): they never expire. A plan's briefs are on GbpSub.
  briefBalance  Int            @default(0)
  /// Founding member number (1 to 15): the first accounts to start a plan get 25% more plan sessions every month.
  foundingNo    Int?           @unique
  /// A team member: the account (its owner's id) they sign in to work in, while its plan has a seat for them.
  teamOf        String?
  /// When they were added: the earliest added keep their seats if the plan gets smaller.
  teamAddedAt   DateTime?
  emailVerifiedAt DateTime?
  scans         GridScan[]
  ledger        CreditLedger[]
  businesses    SavedBusiness[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([teamOf])
}

model CreditLedger {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  reason          String
  externalEventId String?  @unique
  scanId          String?
  pinId           String?
  createdAt       DateTime @default(now())

  @@unique([pinId, reason])
  @@index([userId, createdAt])
}

model DevicePool {
  imageId        String    @id
  proxyId        String    @unique
  slotIndex      Int       @unique @default(autoincrement())
  hardwareModel  String?
  hardwareBrand  String?
  bootstrappedAt DateTime?
  adbAddr        String?
  isEnabled      Boolean   @default(true)
  cooldownUntil  DateTime  @default(now())
  offlineAt      DateTime?
  /// Last 20 pin outcomes, oldest first: S = success, F = phone-attributable failure.
  recentOutcomes  String    @default("")
  pinsSucceeded   Int       @default(0)
  pinsFailed      Int       @default(0)
  lastFailureCode String?
  lastFailureAt   DateTime?
  lastSuccessAt   DateTime?
  /// Set by the worker when the recent failure rate crosses the threshold; cleared by an admin.
  autoPausedAt    DateTime?
  autoPauseReason String?
  /// The Proxy-Seller list this phone's DuoPlus proxy record currently points at.
  proxyListId     String?
  updatedAt      DateTime  @updatedAt
}

model GridScan {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword          String
  targetBusiness   String
  /// Google's ID for the business ("/g/…"), when given: AI answers are matched by it first.
  targetKgmid      String?
  /// The business's website (a bare domain), when given: cited sites are matched by it.
  targetDomain     String?
  targetPlaceId    String?
  targetType       String    @default("mobile_maps")
  phoneBrand       String    @default("Samsung")
  phoneModel       String    @default("Galaxy S23 Ultra")
  trackAiOverviews Boolean   @default(false)
  scheduleType     String    @default("once")
  scheduleCron     String?
  centerLat        Float
  centerLng        Float
  zip              String
  city             String
  stateCode        String
  ispId            String
  /// "any" | "single" | "mix": how the chosen ISPs are spread across the grid.
  ispMode          String    @default("any")
  /// ISP names chosen by the customer, spelled as in Proxy-Seller's GEO data.
  isps             Json?
  /// Proxy-Seller market the scan's lists were prepared for (region "" = not using lists).
  proxyRegion      String?
  proxyCity        String?
  /// "residential" (home internet) or "mobile" (mobile data: a carrier IP in the point's state).
  network          String    @default("residential")
  gridSize         Int       @default(11)
  spacingKm        Float     @default(1.60934)
  totalPins        Int
  completedPins    Int       @default(0)
  failedPins       Int       @default(0)
  campaignId       String    @default(cuid())
  shareToken       String?   @unique
  requestKey       String?   @unique
  leadEmail        String?
  dispatchedAt     DateTime?
  creditsCharged   Int
  creditsRefunded  Int       @default(0)
  status           String    @default("QUEUED")
  arp              Float?
  atrp             Float?
  solv             Float?
  aioTriggerRate   Float?
  aioCitationRate  Float?
  /// 'now' (Scan Now: first in line, 2 points a grid point) or 'scheduled' (1 point, behind Scan Now).
  speed            String    @default("now")
  /// A scheduled scan waits (status SCHEDULED) until this moment.
  runAt            DateTime?
  /// The free re-run of a first $5 audit, a week later; cleared once it has started.
  freeRescanAt     DateTime?
  /// A Live 5G Proof audit: its points run on the unlimited 5G lines only, never on another network.
  laneOnly         Boolean   @default(false)
  pins             GridPin[]
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([userId, createdAt])
  @@index([status, runAt])
  @@index([freeRescanAt])
}

model GridPin {
  id               String   @id @default(cuid())
  scanId           String
  scan             GridScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rowIdx           Int
  colIdx           Int
  lat              Float
  lng              Float
  zip              String
  city             String
  stateCode        String
  status           String   @default("PENDING")
  isRefunded       Boolean  @default(false)
  assignedDeviceId String?
  rankFound        Int?
  matchedDumpIdx   Int?
  topCompetitors   Json?
  hasAiOverview    Boolean  @default(false)
  targetCitedInAi  Boolean  @default(false)
  aiOverviewText   String?  @db.Text
  aiCitations      Json?
  proxyMeta        Json?
  census           Json?
  insights         Json?
  videoUrl         String?
  dumpsTarUrl      String?
  metaJsonUrl      String?
  /// SHA-256 of the raw evidence bundle as received from the phone (the receipt's fingerprint).
  evidenceSha256   String?
  lastError        String?
  /// The ISP this grid point always runs on ("" = any ISP in the market).
  isp              String?
  /// When a phone was first leased for this pin; queue wait = startedAt − scan.dispatchedAt.
  startedAt        DateTime?
  updatedAt        DateTime @updatedAt

  @@unique([scanId, rowIdx, colIdx])
  @@index([scanId, status])
  @@index([startedAt])
}

model UsageBucket {
  key    String @id
  bucket Int
  count  Int
}

model PaymentOrder {
  id        String   @id
  userId    String
  credits   Int
  cents     Int
  captureId String?  @unique
  createdAt DateTime @default(now())
  /// The price-list key of what was bought (null on purchases made before keys were recorded).
  item            String?
  /// Stripe's fingerprint of the card, kept for the welcome pack only: one per card.
  cardFingerprint String?
  /// Set when the payment was sent back (a second welcome pack): no credits were added.
  refundedAt      DateTime?

  @@index([item, cardFingerprint])
}

/// Single-use email links: account verification (grants starter credits) and teaser confirmation.
model EmailToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  purpose   String
  email     String
  userId    String?
  scanId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

/// A Proxy-Seller residential list: one login per (market, ISP, rotation), reused across scans.
model ProxyList {
  id         String   @id @default(cuid())
  psListId   Int      @unique
  region     String
  city       String
  isp        String
  rotation   Int
  host       String
  login      String
  password   String
  ports      Json
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([region, city, isp, rotation])
}

/// Our city/state matched to Proxy-Seller's exact GEO names, with the ISPs available there.
model ProxyMarket {
  key         String   @id
  region      String
  city        String
  level       String
  isps        Json
  refreshedAt DateTime @default(now())
}

/// A client business saved with its keywords and scan defaults, so scans start in one click.
model SavedBusiness {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Business name exactly as it appears on Google.
  name             String
  /// The address, ZIP or place the grid is centred on, as entered.
  centerLabel      String   @default("")
  centerLat        Float
  centerLng        Float
  keywords         String[]
  targetType       String   @default("mobile_chrome")
  gridSize         Int      @default(7)
  spacingKm        Float    @default(1.60934)
  ispMode          String   @default("any")
  isps             String[]
  trackAiOverviews Boolean  @default(false)
  scheduleType     String   @default("once")
  /// Google's ID for the business ("/g/…") and its website, when known.
  kgmid            String?
  domain           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

/// Every Google Business Profile edit sent from the admin editor (through Postproxy).
/// `changes`: the fields that changed, with their risk and old and new values. `before`: the whole
/// profile as Google returned it just before the edit, to restore from. `status`: LIVE (Google shows
/// every change), SENT (accepted, not all showing yet), FAILED (Google or Postproxy refused it).
model GbpEdit {
  id         String    @id @default(cuid())
  userId     String
  profileId  String
  locationId String
  title      String?
  tier       String
  changes    Json
  before     Json
  status     String
  error      String?
  checkedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([locationId, createdAt])
}

/// An account's link to Google for reading Search Console and Analytics. One per account.
/// `refreshToken` is encrypted (AES-256-GCM, key derived from AUTH_SECRET); it is never sent to the browser.
model GoogleConnection {
  userId       String   @id
  email        String
  scopes       String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

/// The change watchdog's memory of one Google listing: the profile as we last knew it (`baseline`,
/// as Google returned it) and the values an admin has agreed to since (`accepted`: field → text).
model GbpWatch {
  locationId String   @id
  profileId  String
  title      String?
  baseline   Json
  accepted   Json     @default("{}")
  baselineAt DateTime @default(now())
  checkedAt  DateTime @default(now())
  problem    String?
}

/// One field of a Google listing that changed without an edit from us. `status`: OPEN (to decide),
/// ACCEPTED (kept), REVERTED (put back), GONE (it went back by itself).
model GbpDrift {
  id         String    @id @default(cuid())
  locationId String
  profileId  String
  title      String?
  field      String
  label      String
  was        String
  now        String
  status     String    @default("OPEN")
  foundAt    DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, foundAt])
  @@index([locationId, field, status])
}

/// Where one job on a business's AI citations checklist stands. The jobs themselves are worked out
/// from each scan; this keeps what the account did about one, so it carries to the next scan of
/// the same business. `business`: the name as a key. `target`: the cited page the job is about.
/// `verifiedScanId`: the later scan that showed the job had worked.
model AioTaskState {
  id             String   @id @default(cuid())
  userId         String
  business       String
  target         String
  playbook       String
  status         String   @default("OPEN")
  originScanId   String?
  verifiedScanId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@unique([userId, business, target, playbook])
}

/// What a look at one page Google's AI cited in a scan found: whether the scanned business is on
/// it and how many of its top rivals are. `note`: ok, blocked (the site refused us) or unreachable.
model AioPageCheck {
  id          String   @id @default(cuid())
  scanId      String
  url         String
  present     Boolean?
  competitors Int      @default(0)
  note        String
  checkedAt   DateTime @default(now())

  @@unique([scanId, url])
}

/// A rival's public Google listing as looked up for the competitor gaps panel (categories,
/// attributes, booking links), kept for 14 days so the same rival is not paid for twice. `key`:
/// the business name as a key plus where it was looked for. `data`: the lookup's answer, or null
/// when no matching listing was found.
/// `posts`: its Google posts (collected separately: asked for with `postsTask`, ready a little later).
model RivalProfile {
  key       String    @id
  name      String
  data      Json?
  fetchedAt DateTime  @default(now())
  postsTask String?
  posts     Json?
  postsAt   DateTime?
}

/// A customer's own Google Business account, connected through Postproxy. Each one sits in its own
/// Postproxy profile group (`groupId`); `profileId` is filled once Google sign-in has finished.
model GbpAccount {
  id        String   @id @default(cuid())
  userId    String
  groupId   String   @unique
  profileId String?  @unique
  name      String?
  createdAt DateTime @default(now())
  /// Since when this connection has had no listing on a paying plan (null while one is). After 7 days it is disconnected.
  unpaidSince DateTime? @default(now())

  @@index([userId])
}

/// A listing a customer pays for. `plan`: MANAGE or AGENT. `status`: PENDING (checkout not
/// finished), ACTIVE (on the subscription), ENDING (taken off; works until `endsAt`).
model GbpPlan {
  id         String    @id @default(cuid())
  userId     String
  profileId  String
  locationId String
  title      String?
  plan       String
  status     String    @default("PENDING")
  endsAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

/// A customer's monthly Stripe subscription for listings: one per account, one line per plan, the
/// quantity on each line being how many listings are on that plan. `status` is Stripe's own word.
model GbpSub {
  userId         String    @id
  customerId     String
  subscriptionId String?   @unique
  status         String    @default("none")
  periodEnd      DateTime?
  updatedAt      DateTime  @default(now())
  /// The AI agents add-on is on this subscription.
  agentAddon     Boolean   @default(false)
  /// Scout seats on the subscription (Command and Dominator seats are its listings on those plans).
  scoutSeats     Int       @default(0) @map("trackSeats")
  /// The seats' points held right after the last grant; the rest of the balance then; when that was (packages/core/creditPlan.ts).
  bucket         Int       @default(0)
  packFloor      Int       @default(0)
  grantAt        DateTime?
  /// Monthly points this month's paid invoices have already covered.
  grantedPoints  Int       @default(0) @map("grantedSeats")
  /// The plan's briefs left this month, and last month's still unused (they roll over for one month).
  briefPlan      Int       @default(0)
  briefCarry     Int       @default(0)
  /// Monthly briefs this month's paid invoices have already covered.
  grantedBriefs  Int       @default(0)
  /// The account plan on the subscription (P_SCOUT, P_AGENCY, P_SCALE), if any.
  accountPlan    String?
  /// 'month' or 'year': how often Stripe bills the subscription. A yearly one still gets its points and briefs each month.
  billingInterval String   @default("month")
  /// When the period Stripe last billed began (a yearly one's months are counted from it).
  periodStart    DateTime?
  /// A yearly subscription: when its next month's points and briefs are due (null once the yearly invoice will bring them).
  nextGrantAt    DateTime?
}

/// A monthly credit plan as a subscription. `bucket`: the plan credits held right after the last
/// renewal; `packFloor`: the rest of the balance at that moment; `grantAt`: when that was. What is
/// left of the plan's credits is worked out from these (packages/core/creditPlan.ts).
model CreditSub {
  userId         String    @id
  customerId     String
  subscriptionId String?   @unique
  plan           String
  status         String    @default("none")
  periodEnd      DateTime?
  bucket         Int       @default(0)
  packFloor      Int       @default(0)
  grantAt        DateTime?
  cancelAtEnd    Boolean   @default(false)
  updatedAt      DateTime  @default(now())
}

/// A key an account gives its own AI agent to reach Stakeout (the MCP server at /api/mcp). Only the
/// SHA-256 of the key is kept; the key itself is shown once, when it is made.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// An AI app that registered itself to sign people in (OAuth Dynamic Client Registration). An app
/// that identifies itself by a metadata address instead has no row here.
model OAuthClient {
  id           String   @id
  name         String
  redirectUris Json
  /// SHA-256 of the app's secret, for one that asked for a secret.
  secretHash   String?
  uri          String?
  createdAt    DateTime @default(now())
}

/// An app a person has approved to act as their account through the MCP server. `clientId`: an
/// OAuthClient id, or the app's metadata address. Revoking it ends every token issued under it.
model OAuthGrant {
  id         String    @id @default(cuid())
  userId     String
  clientId   String
  clientName String
  /// The MCP server address the tokens are for.
  resource   String
  scope      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([clientId])
}

/// A one-time sign-in code, kept as its hash, bound to the app, its callback and its PKCE challenge.
model OAuthCode {
  hash          String    @id
  grantId       String
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  scope         String
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([grantId])
}

/// An access or refresh token, kept as its hash only. `rotatedAt`: when a refresh token was swapped for a new one.
model OAuthToken {
  hash      String    @id
  grantId   String
  kind      String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  @@index([grantId])
  @@index([expiresAt])
}

/// A reply an account's AI agent wrote to a low-rated review. It is never sent by itself: a person
/// reads it in the review inbox and sends or discards it.
model ReviewDraft {
  id        String   @id @default(cuid())
  profileId String
  reviewId  String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([profileId, reviewId])
}

/// How many scan credits an account's AI agents may spend in a month (null: the default), and how
/// many they have spent in `month` (YYYY-MM).
model AgentLimit {
  userId         String   @id
  monthlyCredits Int?
  month          String   @default("")
  used           Int      @default(0)
  updatedAt      DateTime @default(now())
}

/// The lasting copy of things that are read from Redis: admin settings, white-label brands and
/// their logos, merged client names, the review-alert secret (see packages/core/kept.ts).
model Kept {
  scope     String
  key       String
  value     String   @db.Text
  updatedAt DateTime @default(now())

  @@id([scope, key])
}

/// A white-label service an agency ordered for one of its clients (citations, local traffic),
/// fulfilled by hand. Statuses: awaiting_payment, intake_submitted, live, completed, paused.
/// A compiled revenue brief: the brief as it stood when compiled, so everyone who opens it reads the same numbers.
model Brief {
  id          String   @id @default(cuid())
  /// The account that compiled it (the scan's owner).
  userId      String   @map("user_id")
  /// The scan it was opened from.
  scanId      String   @map("scan_id")
  business    String
  /// The scoring version it was built with.
  version     String
  /// The brief as built: numbers, words and the local prices, shown as they are.
  data        Json
  /// The firm's own inputs for the modeled figures, changed after compiling (free).
  assumptions Json?
  /// Its share link, once one is made.
  shareToken  String?  @unique @map("share_token")
  /// What paid for it: carry (last month's plan brief), plan, bought, or admin.
  paidBy      String   @default("admin") @map("paid_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([scanId])
  @@map("briefs")
}

model ServiceOrder {
  id             String   @id
  /// The account that ordered it.
  userId         String   @map("workspace_id")
  /// The client's Google listing ("accounts/…/locations/…"), or a business from scans ("scan:<name>").
  locationId     String   @map("location_id")
  clientName     String   @map("client_name")
  /// citation_sync | traffic_boost
  serviceType    String   @map("service_type")
  /// The Stripe checkout, then the subscription of a monthly service.
  stripeRef      String   @map("stripe_checkout_or_sub_id")
  checkoutId     String   @unique @map("checkout_id")
  status         String   @default("awaiting_payment")
  cents          Int
  /// What the agency filled in: the business details, keywords, areas, where the ads go.
  intake         Json     @map("intake_payload_json")
  /// The proof report for the client (a link), once there is one.
  deliverableUrl String?  @map("deliverable_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("service_orders")
}

/// A live report embed: an iframe that always shows the newest finished scan of one business,
/// keyword and grid (the scan it was made from fixes which). Made on Agency and up; it keeps working
/// after a move down, with our badge in place of the account's brand.
model ReportEmbed {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  scanId    String
  keyword   String
  business  String
  gridSize  Int
  centerLat Float
  centerLng Float
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

/// Where an account's scan-finished webhooks go (Scale and up), and the secret they are signed with.
model WebhookEndpoint {
  userId    String   @id
  url       String
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One webhook to send: tried at once, then again 1, 5 and 30 minutes later (four tries in all).
model WebhookDelivery {
  id         String    @id @default(cuid())
  userId     String
  scanId     String?
  event      String
  payload    Json
  /// PENDING, SENT, FAILED (every try used) or SKIPPED (no endpoint, or the plan no longer has webhooks).
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  nextAt     DateTime  @default(now())
  lastStatus Int?
  lastError  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([status, nextAt])
  @@index([userId, createdAt])
}
