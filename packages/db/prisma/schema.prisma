// packages/db/prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          String         @default("AGENCY")
  creditBalance Int            @default(0)
  emailVerifiedAt DateTime?
  scans         GridScan[]
  ledger        CreditLedger[]
  businesses    SavedBusiness[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CreditLedger {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  reason          String
  externalEventId String?  @unique
  scanId          String?
  pinId           String?
  createdAt       DateTime @default(now())

  @@unique([pinId, reason])
  @@index([userId, createdAt])
}

model DevicePool {
  imageId        String    @id
  proxyId        String    @unique
  slotIndex      Int       @unique @default(autoincrement())
  hardwareModel  String?
  hardwareBrand  String?
  bootstrappedAt DateTime?
  adbAddr        String?
  isEnabled      Boolean   @default(true)
  cooldownUntil  DateTime  @default(now())
  offlineAt      DateTime?
  /// Last 20 pin outcomes, oldest first: S = success, F = phone-attributable failure.
  recentOutcomes  String    @default("")
  pinsSucceeded   Int       @default(0)
  pinsFailed      Int       @default(0)
  lastFailureCode String?
  lastFailureAt   DateTime?
  lastSuccessAt   DateTime?
  /// Set by the worker when the recent failure rate crosses the threshold; cleared by an admin.
  autoPausedAt    DateTime?
  autoPauseReason String?
  /// The Proxy-Seller list this phone's DuoPlus proxy record currently points at.
  proxyListId     String?
  updatedAt      DateTime  @updatedAt
}

model GridScan {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword          String
  targetBusiness   String
  targetPlaceId    String?
  targetType       String    @default("mobile_maps")
  phoneBrand       String    @default("Samsung")
  phoneModel       String    @default("Galaxy S23 Ultra")
  trackAiOverviews Boolean   @default(false)
  scheduleType     String    @default("once")
  scheduleCron     String?
  centerLat        Float
  centerLng        Float
  zip              String
  city             String
  stateCode        String
  ispId            String
  /// "any" | "single" | "mix": how the chosen ISPs are spread across the grid.
  ispMode          String    @default("any")
  /// ISP names chosen by the customer, spelled as in Proxy-Seller's GEO data.
  isps             Json?
  /// Proxy-Seller market the scan's lists were prepared for (region "" = not using lists).
  proxyRegion      String?
  proxyCity        String?
  gridSize         Int       @default(11)
  spacingKm        Float     @default(1.60934)
  totalPins        Int
  completedPins    Int       @default(0)
  failedPins       Int       @default(0)
  campaignId       String    @default(cuid())
  shareToken       String?   @unique
  requestKey       String?   @unique
  leadEmail        String?
  dispatchedAt     DateTime?
  creditsCharged   Int
  creditsRefunded  Int       @default(0)
  status           String    @default("QUEUED")
  arp              Float?
  atrp             Float?
  solv             Float?
  aioTriggerRate   Float?
  aioCitationRate  Float?
  pins             GridPin[]
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([userId, createdAt])
}

model GridPin {
  id               String   @id @default(cuid())
  scanId           String
  scan             GridScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rowIdx           Int
  colIdx           Int
  lat              Float
  lng              Float
  zip              String
  city             String
  stateCode        String
  status           String   @default("PENDING")
  isRefunded       Boolean  @default(false)
  assignedDeviceId String?
  rankFound        Int?
  matchedDumpIdx   Int?
  topCompetitors   Json?
  hasAiOverview    Boolean  @default(false)
  targetCitedInAi  Boolean  @default(false)
  aiOverviewText   String?  @db.Text
  aiCitations      Json?
  proxyMeta        Json?
  videoUrl         String?
  dumpsTarUrl      String?
  metaJsonUrl      String?
  /// SHA-256 of the raw evidence bundle as received from the phone (the receipt's fingerprint).
  evidenceSha256   String?
  lastError        String?
  /// The ISP this grid point always runs on ("" = any ISP in the market).
  isp              String?
  /// When a phone was first leased for this pin; queue wait = startedAt − scan.dispatchedAt.
  startedAt        DateTime?
  updatedAt        DateTime @updatedAt

  @@unique([scanId, rowIdx, colIdx])
  @@index([scanId, status])
  @@index([startedAt])
}

model UsageBucket {
  key    String @id
  bucket Int
  count  Int
}

model PaymentOrder {
  id        String   @id
  userId    String
  credits   Int
  cents     Int
  captureId String?  @unique
  createdAt DateTime @default(now())
}

/// Single-use email links: account verification (grants starter credits) and teaser confirmation.
model EmailToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  purpose   String
  email     String
  userId    String?
  scanId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

/// A Proxy-Seller residential list: one login per (market, ISP, rotation), reused across scans.
model ProxyList {
  id         String   @id @default(cuid())
  psListId   Int      @unique
  region     String
  city       String
  isp        String
  rotation   Int
  host       String
  login      String
  password   String
  ports      Json
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([region, city, isp, rotation])
}

/// Our city/state matched to Proxy-Seller's exact GEO names, with the ISPs available there.
model ProxyMarket {
  key         String   @id
  region      String
  city        String
  level       String
  isps        Json
  refreshedAt DateTime @default(now())
}

/// A client business saved with its keywords and scan defaults, so scans start in one click.
model SavedBusiness {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Business name exactly as it appears on Google.
  name             String
  /// The address, ZIP or place the grid is centred on, as entered.
  centerLabel      String   @default("")
  centerLat        Float
  centerLng        Float
  keywords         String[]
  targetType       String   @default("mobile_chrome")
  gridSize         Int      @default(7)
  spacingKm        Float    @default(1.60934)
  ispMode          String   @default("any")
  isps             String[]
  trackAiOverviews Boolean  @default(false)
  scheduleType     String   @default("once")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}
