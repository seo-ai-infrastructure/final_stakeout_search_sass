# Copy into your cloud environment. Never commit populated settings.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Default neon. Use tcp only for plain PostgreSQL or an isolated local test.
DB_TRANSPORT=neon
AUTH_SECRET=
REDIS_URL=
DUOPLUS_API_KEY=
PROXY_SELLER_BASE_LOGIN=
PROXY_SELLER_PASSWORD=
PROXY_SELLER_HOST=us.res.proxy-seller.com
PROXY_PORT=10000
# Enable only for a provider configuration with one distinct port per fleet slot.
PROXY_USE_SLOT_PORT=false
# Provider-issued numeric IDs; map the wizard's ISP code and state abbreviation.
# Set PROXY_ISP_IDS_JSON on Vercel too: the wizard only offers ISPs listed here.
PROXY_ISP_IDS_JSON={}
PROXY_STATE_IDS_JSON={}
# Reject exits whose proxy-check region is not the pin's state (recommended).
PROXY_REQUIRE_STATE_MATCH=true
# Extra Android model strings per profile, e.g. {"Galaxy S23 Ultra":["SM-S918N"]}
HARDWARE_MODEL_ALIASES_JSON=
# Minutes a pin waits for a phone of the requested model to come online before refunding.
NO_DEVICE_GRACE_MINUTES=30
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stakeout-artifacts
# The bucket's S3 API URL if it shows a jurisdiction (e.g. https://<account>.us.r2.cloudflarestorage.com).
R2_ENDPOINT=
MOBILE_CONCURRENCY=5
# Opt-in only after verifying detach/rebind on a dedicated staging image.
UNBIND_PROXY_BEFORE_UPLOAD=false
TEASER_DAILY_LIMIT=25
# Optional: preferred phone for free previews (falls back to any online model).
TEASER_PHONE_MODEL=
# Abuse controls (web). Starter credits are granted only after the email is confirmed.
WELCOME_CREDITS=150
REGISTER_DAILY_LIMIT=200
# Header your edge sets with the real client IP when not on Vercel (e.g. cf-connecting-ip).
TRUSTED_IP_HEADER=
# Cloudflare Turnstile for sign-up and free previews.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Transactional email (Resend). Required for verification links and teaser confirmation.
RESEND_API_KEY=
EMAIL_FROM=Stakeout <no-reply@your-domain.com>
APP_URL=https://your-app.vercel.app
# Disposable test instances only: grants starter credits without email confirmation.
EMAIL_VERIFICATION_REQUIRED=true
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Prices in USD cents. Only packs with a positive configured price can be sold.
PAYPAL_PACK_500_USD_CENTS=
PAYPAL_PACK_750_USD_CENTS=
PAYPAL_PACK_3000_USD_CENTS=
PAYPAL_PACK_7500_USD_CENTS=
# Optional desktop runtime, enable in web and worker only after configuring it.
NEXT_PUBLIC_DESKTOP_ENABLED=false
DESKTOP_ENABLED=false
DESKTOP_PROXY_URL=
DESKTOP_ANSWER_SELECTOR=
# Optional licensed MapLibre style URL
NEXT_PUBLIC_MAP_STYLE_URL=
# Deployment script inputs, set the target explicitly.
NEON_ORG_ID=
NEON_PROJECT_ID=
NEON_BRANCH=

# --- Fleet scaling (worker) ---
# Shell commands go over ADB (no API cost) when a phone has an ADB address; "api" forces the DuoPlus API.
DEVICE_TRANSPORT=adb
# DuoPlus allows 1 request/second per account; this spacing is shared by all workers and the web app.
DUOPLUS_MIN_INTERVAL_MS=1050
# Phone setting changes arriving within this window are sent as one request.

# Exit IP lookup run ON the phone (through its proxy). Optional ipinfo.io token for higher limits.
IP_CHECK_URL=https://ipinfo.io/json
IPINFO_TOKEN=
# New phones found by fleet sync are bootstrapped automatically.
AUTO_BOOTSTRAP=true
FLEET_SYNC_MINUTES=5
# Auto-pause a phone when at least this share of its last pins failed (needs AUTO_PAUSE_MIN_PINS pins).
AUTO_PAUSE_FAILURE_RATE=0.2
AUTO_PAUSE_MIN_PINS=10
# Safe to set above the phone count: the phone lease is what limits real work. Use phones + 2.
MOBILE_CONCURRENCY=5

# --- Proxy-Seller residential lists (web AND worker) ---
# With a key set, every scan prepares a list per chosen ISP in its market before the grid runs.
# The key sits in the URL path of every call; it is never logged.
PROXY_SELLER_API_KEY=
# 0 = new IP on every request (default), -1 = sticky, 1–3600 = rotate every N seconds.
PROXY_LIST_ROTATION=0
# Ports issued per list; each port is an independent exit. At least the phone count.
PROXY_LIST_PORTS=50

# --- Evidence transfer (worker) ---
# adb_pull (default when the phone has ADB): the worker pulls each bundle over ADB and uploads it
# to R2 itself, so videos never cross the residential proxy. phone_upload: the phone uploads with curl.
EVIDENCE_TRANSFER=adb_pull
# GPS waves: wait up to this long for other phones starting pins, then send one batched update.
DUOPLUS_BATCH_WINDOW_MS=2500

# The worker keeps its own public IP on DuoPlus's ADB whitelist (DuoPlus replaces the whole
# list each time, max 10). List other machines that need ADB access, e.g. your PC:
DUOPLUS_ADB_WHITELIST_EXTRA=
# Set to false to manage the ADB whitelist by hand instead.
DUOPLUS_ADB_WHITELIST_AUTO=true
# Optional: only use and set up these DuoPlus phones (comma-separated IDs). Empty = every phone that is on.
DUOPLUS_PHONE_IDS=
# A phone whose emulated SIM reports another country gets a matched US carrier at setup. false = leave SIMs alone.
DUOPLUS_US_SIM=true

# --- Residential proxy pre-flight gatekeeper (worker) ---
# -1 = sticky: one exit IP per port. Each grid point leases its own port, and the exit is
# checked from the phone before recording (ipinfo + ip-api agree on US + state, no hosting
# range, residential network, Google serves English on google.com), then re-checked after.
PROXY_LIST_ROTATION=-1
# strict = residential ASN/ISP-name allow-list; deny = only block datacenter/hosting; off = no network check
PROXY_GATE=strict
# Extra residential ASNs to allow in strict mode, e.g. AS4181,AS12345
PROXY_ASN_ALLOW=
# A used port rests this long before another point may use it; a rejected port is benched for hours
PROXY_PORT_REST_MINUTES=30
PROXY_PORT_BAD_HOURS=6
# Ports tried per list before falling back to the next list
PROXY_PORT_TRIES=4
