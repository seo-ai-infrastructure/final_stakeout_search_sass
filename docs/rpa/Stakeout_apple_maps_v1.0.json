{
  "config": [
    {
      "key": "keyword",
      "value": "plumber",
      "type": "string",
      "required": true,
      "desc": "ONE exact keyword, set per run by the Stakeout worker"
    },
    {
      "key": "pin_id",
      "value": "test_1_1",
      "type": "string",
      "required": true,
      "desc": "names this run's files in /sdcard/stakeout; set per run by the Stakeout worker"
    },
    {
      "key": "start_url",
      "value": "https://maps.apple.com/search",
      "type": "string",
      "required": true,
      "desc": "Apple Maps opened on the grid point: set per run by the Stakeout worker (https://maps.apple.com/search?center=<lat>%2C<lng>&span=...). Apple searches the part of the map on screen, so this is what places each search"
    },
    {
      "key": "record_start",
      "value": "before typing",
      "type": "string",
      "required": true,
      "desc": "the video starts when this template marks it, right before the keyword is typed"
    },
    {
      "key": "template_version",
      "value": "1.0",
      "type": "string",
      "required": false,
      "desc": "Template version: recorded in every receipt and shown on the admin System health card"
    }
  ],
