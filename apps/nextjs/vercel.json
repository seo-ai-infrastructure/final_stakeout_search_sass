{
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run db:generate && npm -w @stakeout/web run build",
  "crons": [
    {
      "path": "/api/alerts/flush",
      "schedule": "17 13 * * *"
    },
    {
      "path": "/api/cron/gbp-watch",
      "schedule": "43 10 * * *"
    },
    {
      "path": "/api/cron/plan-months",
      "schedule": "7 6 * * *"
    }
  ]
}
